            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Created correct ID" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="-1306228749">&quot;studentId&quot;:&quot;${newId}&quot;</stringProp>
